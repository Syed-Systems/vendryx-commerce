# Full-stack Docker run: copy to .env and adjust secrets.
# Usage:  docker compose --env-file .env up --build
#
# Only Docker Desktop is required. No Rust, Node, Git Bash, or run-dev.bat.

# --- Engine ---------------------------------------------------------------
# Postgres as seen from inside the compose network (do NOT change the host part
# unless the postgres service is renamed).
DATABASE_URL=postgres://stheno:stheno@postgres:5432/stheno
REDIS_URL=redis://redis:6379

# CHANGE THESE before any non-local use. Dev defaults only.
JWT_SECRET=
COOKIE_SECRET=
STHENO_CREDENTIAL_KEY=
STHENO_PLATFORM_TOKEN=dev-platform-token

# Browser origins allowed to call the engine directly (platform console).
ADMIN_CORS=http://localhost:6100,http://127.0.0.1:6100,http://localhost:6001,http://127.0.0.1:6001
STORE_CORS=http://localhost:8000,http://127.0.0.1:8000
AUTH_CORS=http://localhost:6100,http://127.0.0.1:6100,http://localhost:8000,http://127.0.0.1:8000

# --- Bootstrap (dev tenants) ----------------------------------------------
STHENO_DEV_PASSWORD=

# --- Storefront build args -------------------------------------------------
NEXT_PUBLIC_STHENO_PUBLISHABLE_KEY=pk_test
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=us

# --- Admin / platform / marketing build args -------------------------------
VITE_STHENO_STOREFRONT_URL=http://localhost:8000
VITE_STHENO_BACKEND_URL=http://localhost:9000
VITE_ADMIN_URL=http://localhost:6100

# --- Host ports (Windows reserves 5429-5528 and 5141-5240; 6000 is a Chromium
# restricted port — these defaults avoid all three) --------------------------
ENGINE_PORT=9000
STOREFRONT_PORT=8000
ADMIN_PORT=6100
PLATFORM_PORT=6001
MARKETING_PORT=6002
