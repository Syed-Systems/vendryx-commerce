{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "./src",
    "paths": {
      "@core/*": ["../packages/storefront-core/src/*"],
      "@theme/*": ["../packages/theme-default/src/modules/*"],
      "@lib/*": ["../packages/storefront-core/src/lib/*"],
      "@modules/checkout/*": ["../packages/storefront-core/src/modules/checkout/*"],
      "@modules/common/components/localized-client-link": ["../packages/storefront-core/src/modules/common/components/localized-client-link"],
      "@modules/*": ["../packages/theme-default/src/modules/*"],
      "@pages/*": ["pages/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "packages/theme-fixture-violating",
    ".next",
    ".nyc_output",
    "coverage",
    "jest-coverage"
  ]
}
