{
  "name": "@stheno/storefront",
  "version": "1.0.3",
  "private": true,
  "author": "Syed Systems",
  "description": "Stheno storefront — Next.js App Router against the Stheno commerce engine",
  "keywords": [
    "stheno-storefront"
  ],
  "scripts": {
    "dev": "node scripts/frontend.js default dev -p 8000",
    "build": "node scripts/frontend.js default build",
    "start": "node scripts/frontend.js default start -p 8000",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "test:e2e": "playwright test",
    "test:lighthouse": "node tests/lighthouse/runner.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:matrix": "node scripts/frontend.js matrix dev -p 8001",
    "dev:parallel": "node scripts/frontend.js --parallel mahal:8000 matrix:8001",
    "build:matrix": "node scripts/frontend.js matrix build",
    "start:matrix": "node scripts/frontend.js matrix start -p 8001",
    "typecheck:matrix": "tsc --noEmit -p tsconfig.matrix.json",
    "dev:mahal": "node scripts/frontend.js mahal dev -p 8003",
    "build:mahal": "node scripts/frontend.js mahal build",
    "start:mahal": "node scripts/frontend.js mahal start -p 8003",
    "typecheck:mahal": "tsc --noEmit -p tsconfig.mahal.json",
    "dev:appliance": "node scripts/frontend.js appliance dev -p 8004",
    "build:appliance": "node scripts/frontend.js appliance build",
    "start:appliance": "node scripts/frontend.js appliance start -p 8004",
    "typecheck:appliance": "tsc --noEmit -p tsconfig.appliance.json"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.0",
    "@medusajs/icons": "latest",
    "@medusajs/js-sdk": "latest",
    "@medusajs/ui": "latest",
    "@radix-ui/react-accordion": "^1.2.1",
    "@stheno/frontend-default": "*",
    "@stheno/storefront-core": "*",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "gsap": "^3.15.0",
    "lodash": "^4.17.21",
    "next": "15.3.9",
    "pg": "^8.11.3",
    "qs": "^6.12.1",
    "react": "19.0.5",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.0.5",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0",
    "webpack": "^5"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@medusajs/types": "latest",
    "@medusajs/ui-preset": "latest",
    "@playwright/test": "^1.62.1",
    "@types/lodash": "^4.14.195",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "@types/react-instantsearch-dom": "^6.12.3",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "babel-loader": "^8.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.3.9",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.0.23",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5"
  },
  "overrides": {
    "react": "19.0.5",
    "react-dom": "19.0.5"
  },
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
